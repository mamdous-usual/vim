# =============== Common Methods ===============

snippet method "static method"
static ${1:void} ${2:methodName}(${3}) {
	${0}
}
endsnippet

snippet gcd "GCD method"
static long gcd(long a, long b) {
	return b == 0 ? a : gcd(b, a % b);
}
endsnippet

snippet pow "Power method"
static long pow(long a, long b) {
	long res = 1;
	while (b > 0) {
		if (b % 2 == 1) res *= a;
		a *= a;
		b /= 2;
	}
	return res;
}
endsnippet

snippet prime "isPrime method"
static boolean isPrime(int n) {
	if (n <= 1) return false;
	if (n <= 3) return true;
	if (n % 2 == 0 || n % 3 == 0) return false;
	for (int i = 5; i * i <= n; i += 6) {
		if (n % i == 0 || n % (i + 2) == 0) return false;
	}
	return true;
}
endsnippet

