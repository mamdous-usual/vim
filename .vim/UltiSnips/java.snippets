# =====================================================
# Simple Java Snippets for Competitive Programming
# =====================================================

# =============== Main Class Templates ===============

snippet classm "Class with main method"
public class `!v expand('%:t:r')` {
	public static void main(String[] args) {
		${0}
	}
}
endsnippet

snippet classc "Class with Scanner (Competitive Programming)"
import java.util.*;

public class `!v expand('%:t:r')` {
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		${0}
		sc.close();
	}
}
endsnippet

snippet classf "Class with Fast I/O (Competitive Programming)"
import java.util.*;
import java.io.*;

public class `!v expand('%:t:r')` {
	public static void main(String[] args) throws IOException {
		BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
		PrintWriter pw = new PrintWriter(System.out);
		
		${0}
		
		pw.close();
	}
}
endsnippet

snippet classfull "Full CP Template with Fast I/O helpers"
import java.util.*;
import java.io.*;

public class `!v expand('%:t:r')` {
	static BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
	static PrintWriter pw = new PrintWriter(System.out);
	static StringTokenizer st;
	
	public static void main(String[] args) throws IOException {
		${0}
		pw.close();
	}
	
	static String next() throws IOException {
		while (st == null || !st.hasMoreTokens())
			st = new StringTokenizer(br.readLine());
		return st.nextToken();
	}
	
	static int nextInt() throws IOException {
		return Integer.parseInt(next());
	}
	
	static long nextLong() throws IOException {
		return Long.parseLong(next());
	}
}
endsnippet

